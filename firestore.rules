rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Players ──────────────────────────────────────────────────────────────
    match /players/{playerId} {
      allow read: if true;
      allow create, delete: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pushSubscription']);
    }

    // ── Player PINs (hashed) — server-side Admin SDK only ─────────────────────
    match /playerPins/{playerId} {
      allow read, write: if false;
    }

    // ── Rounds + subcollections ───────────────────────────────────────────────
    match /rounds/{roundId} {
      allow read: if true;
      allow write: if true;

      match /votes/{voteId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }

      match /fanVotes/{voteId} {
        allow read: if true;
        allow create: if true;
        allow update: if false;
        allow delete: if true;   // fans can cancel their own vote
      }

      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }

      match /goals/{goalId} {
        allow read: if true;
        allow create: if true;
        allow delete: if true;   // UI restricts delete to the submitting fan
        allow update: if false;
      }

      match /chat/{chatId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if true;   // UI restricts to the sending fan
      }

      match /predictions/{predId} {
        allow read: if true;
        allow create, update: if true;   // setDoc upserts fan prediction
        allow delete: if false;
      }
    }

    // collectionGroup queries
    match /{path=**}/votes/{voteId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /{path=**}/fanVotes/{voteId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if true;   // fans can cancel their own vote
    }

    match /{path=**}/messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /{path=**}/chat/{chatId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // ── Support requests ─────────────────────────────────────────────────────
    match /support/{requestId} {
      allow read, create: if true;
      allow update: if true;   // fans update lastMessage; admin updates status
      allow delete: if false;

      match /messages/{msgId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }

    // ── Fan PINs (hashed) — server-side Admin SDK only ───────────────────────
    match /fanPins/{fanId} {
      allow read, write: if false;
    }

    // ── League Matches + config (ladder data) ────────────────────────────────
    match /leagueMatches/{matchId} {
      allow read: if true;
      allow write: if true;
    }
    match /ladderConfig/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Fans ─────────────────────────────────────────────────────────────────
    match /fans/{fanId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fanPushSubscription', 'notificationSettings']);
      allow delete: if false;
    }
  }
}
