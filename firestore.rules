rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Players ──────────────────────────────────────────────────────────────
    match /players/{playerId} {
      allow read: if true;
      allow create, delete: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin', 'pushSubscription']);
    }

    // ── Rounds + subcollections ───────────────────────────────────────────────
    match /rounds/{roundId} {
      allow read: if true;
      allow write: if true;

      match /votes/{voteId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }

      match /fanVotes/{voteId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }

    // collectionGroup queries
    match /{path=**}/votes/{voteId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /{path=**}/fanVotes/{voteId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /{path=**}/messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ── Fans ─────────────────────────────────────────────────────────────────
    match /fans/{fanId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin']);
      allow delete: if false;
    }
  }
}
